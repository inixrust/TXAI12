# Jaga konteks build tetap kecil & rahasia tak ikut terkirim ke daemon.
.git
.venv
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Rahasia & data lokal - JANGAN masuk image.
# (chunks.json TIDAK dikecualikan - indeks korpus itu dibutuhkan saat runtime.)
.env
*.snap

# Berat / tak diperlukan saat runtime container.
tests
docs
incoming_documents
infra/openbao/backups
# CATATAN: JANGAN kecualikan *.pdf/*.png secara luas - berkas di
# scanned_documents/ (PDF pindaian) DIBUTUHKAN UI untuk menampilkan pratinjau
# halaman sumber (citations.scanned_page). documents/ juga dipakai jalur sitasi.
