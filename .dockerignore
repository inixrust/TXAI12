# Jaga konteks build tetap kecil & rahasia tak ikut terkirim ke daemon.
.git
.venv
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Rahasia & data lokal - JANGAN masuk image.
# (chunks.json TIDAK dikecualikan - indeks korpus itu dibutuhkan saat runtime.)
.env
*.snap

# Berat / tak diperlukan saat runtime container.
tests
docs
incoming_documents
infra/openbao/backups

# DATA (bukan kode) - TIDAK ikut ke image; di-mount sebagai volume saat runtime
# (lihat service `app` di compose-infra.yaml). Dikecualikan dari konteks build
# agar build tetap ramping. Perbarui korpus tanpa rebuild image.
documents
scanned_documents
source_originals
chroma_db
chunks.json
testset.json
testset_hybrid.json
index_meta.json
