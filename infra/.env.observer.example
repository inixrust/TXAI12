# Rahasia untuk stack observability (infra/compose-observer.yaml / Langfuse).
# SALIN ke infra/.env.observer (DI-GITIGNORE) dan isi untuk PRODUKSI. Tanpa
# berkas ini, compose memakai DEFAULT LAB yang ada di compose (bertanda CHANGEME).
#
# Pakai:  docker compose -f infra/compose-observer.yaml --env-file infra/.env.observer up -d
#
# ⚠️ SALT & ENCRYPTION_KEY: JANGAN diubah pada basis data yang SUDAH berisi data.
#    Data lama dienkripsi dengan nilai lama -> ganti = data tak terbaca. Set
#    sekali saat FRESH, lalu jangan diutak-atik.

# Inti keamanan Langfuse
NEXTAUTH_SECRET=ganti-rahasia-nextauth
SALT=ganti-salt
ENCRYPTION_KEY=            # 64 hex; buat: openssl rand -hex 32

# Basis data & storage internal Langfuse
POSTGRES_PASSWORD=ganti-postgres
CLICKHOUSE_PASSWORD=ganti-clickhouse
REDIS_AUTH=ganti-redis
MINIO_ROOT_PASSWORD=ganti-minio

# URL publik (bila diakses lewat Caddy TLS, arahkan ke host HTTPS-nya)
# NEXTAUTH_URL=https://langfuse.localhost:8443

# Provisioning otomatis org/user/API key saat FRESH (opsional; kalau kosong,
# daftar manual lewat UI). Kunci ini yang dipakai aplikasi mengirim jejak.
# LANGFUSE_INIT_ORG_ID=txai12
# LANGFUSE_INIT_PROJECT_ID=txai12
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...
# LANGFUSE_INIT_USER_EMAIL=instruktur@lab.local
# LANGFUSE_INIT_USER_PASSWORD=lab2026lab2026
