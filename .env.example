# Salin menjadi .env, lalu sesuaikan. Jangan commit .env yang berisi kunci.
#
#   Linux/macOS :  cp .env.contoh .env  &&  set -a && . ./.env && set +a
#   PowerShell  :  Get-Content .env | ForEach-Object {
#                    if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }

# --- model ---------------------------------------------------------------
MODEL_CHAT=qwen3:8b
MODEL_EMBEDDING=bge-m3
MODEL_VISION=qwen3-vl:4b

# Resolusi render untuk VLM. HARUS diukur per model — lihat tabel di README.
# 150 benar untuk qwen3-vl:4b; turunkan ke 110 untuk model vision lebih kecil.
DPI_RENDER=150

# Matikan mode thinking. Tanpa ini qwen3-vl:4b mengembalikan teks KOSONG.
REASONING_VLM=0

# --- penyimpanan ---------------------------------------------------------
# pgvector (bawaan - RLS di basis data) atau chroma (tanpa hak-akses per-users).
# Bawaannya pgvector demi keamanan; setel chroma hanya untuk peragaan/tanpa Postgres.
STORAGE=pgvector
PG_URL=postgresql+psycopg://rag:rahasia_lab@localhost:6024/korpus
PG_URL_DIRECT=postgresql://rag:rahasia_lab@localhost:6024/korpus

# --- mode & rahasia ------------------------------------------------------
# Bawaan: RAG_ENV=lab — kredensial demo di atas boleh dipakai (host lokal).
# Untuk deploy sungguhan setel RAG_ENV=production: setiap kredensial WAJIB
# datang dari environment, dan yang kosong menggagalkan proses saat start.
# Apa pun modenya, sandi demo di atas DITOLAK bila host-nya bukan lokal.
# RAG_ENV=lab

# --- MCP Oracle (L7, L8) -------------------------------------------------
# Bawaannya `sql -mcp` dari PATH. Isi SQLCL_HOME hanya bila SQLcl dijalankan
# dari lingkungan TANPA terminal (CI, agen otomatis) — skrip peluncurnya
# menuntut konsol dan gagal dengan "java.io.IOException: Incorrect function",
# padahal mode -mcp tidak butuh konsol sama sekali.
# SQLcl tidak perlu diunduh terpisah: image Oracle Free 26ai sudah
# membawanya, tapi JDK di dalam container Java 11 sedangkan -mcp butuh
# Java 17. Salin keluar, lalu jalankan dengan Java 17 milik host:
#   docker cp oracle-txai12:/opt/oracle/product/26ai/dbhomeFree/sqlcl ~/sqlcl
# SQLCL_HOME=/jalur/ke/sqlcl

# --- observability (L12) -------------------------------------------------
# Kosongkan salah satu kunci untuk mematikan jejak. Sistem tetap berjalan.
LANGFUSE_HOST=http://localhost:3000
# Kunci ini DITETAPKAN lewat inisialisasi headless Langfuse, bukan
# digenerasi — lihat README bagian Langfuse. Sama untuk seluruh kelas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- setelan Ollama untuk VRAM terbatas (L2) -----------------------------
# Ini variabel untuk PROSES OLLAMA, bukan untuk lab. Setel sebelum
# menjalankan `ollama serve`, bukan di sini.
#   OLLAMA_KEEP_ALIVE=0
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1

# ---------------------------------------------------------------
# Ditambahkan agar berkas ini sinkron dengan config.py. Nilai kosong
# berarti memakai bawaan di kode.

# DPI_FALLBACK=
# KEEP_ALIVE_VLM=
# MAX_UPLOAD_MB=
# MAX_UPLOAD_PAGES=
# MCP_COMMAND=
# MCP_CONNECTION_NAME=
# Akun OPERATOR terpisah (penutupan penuh F-02, oracle/04-operator-account.sql).
# rag_baca (produksi) tak boleh 'lihat semua'; CLI/evaluasi memakai koneksi ini.
# Simpan koneksinya: python -m ragcore.commands.mcp --simpan-operator
# MCP_CONNECTION_OPERATOR=agentlab_op
# ORACLE_CONNECTION_OPERATOR=rag_operator/GANTI_SANDI@localhost:1521/FREEPDB1
# NUM_CTX_CHAT=
# NUM_CTX_VLM=
# OLLAMA_BASE_URL=
# PG_URL_APP=
# ORACLE_CONNECTION=
# SELF_QUERY=
# STORAGE=
