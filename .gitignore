hasil-evaluasi.json

# setelan lokal per mesin
.env
infra/.env.observer

# RAHASIA infra - JANGAN pernah di-commit
# (kunci unseal untuk auto-unseal lab, dan snapshot OpenBao)
infra/openbao/unseal-keys.txt
*.snap

# artefak Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# artefak runtime lab (dibuat ulang, tak perlu di-track)
chroma_db/
# Dokumen unggahan pengguna: ISINYA tak di-track (data pengguna), tetapi
# FOLDER-nya dipertahankan lewat .gitkeep supaya target bind-mount compose
# sudah ada saat fresh clone (kalau tak ada, Docker membuatnya root-owned dan
# app uid 10001 gagal menulis).
incoming_documents/*
!incoming_documents/.gitkeep
*.vlm.txt
evaluation-result.json
evaluation-history.json
